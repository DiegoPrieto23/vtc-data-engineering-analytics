# Plantilla de configuración. Copia este fichero a `.env` y rellena los valores.
#   cp .env.example .env
#
# El fichero `.env` NO se sube al repositorio (está en .gitignore).

# Host de PostgreSQL. Usa `postgres` al ejecutar con Docker Compose
# y `localhost` si te conectas desde fuera de los contenedores.
PG_HOST=postgres
PG_PORT=5432
PG_DB=vtc_db
PG_USER=postgres

# Contraseña de la base de datos. Genera una propia, por ejemplo con:
#   openssl rand -base64 24
PG_PASSWORD=

# Entidad a procesar: all | drivers | users | cars | trips
PIPELINE_TARGET=all
